{
  "name": "specula",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "config-ui": "node --import tsx/esm scripts/run-config-ui.ts",
    "test:watch": "vitest",
    "test:analyzer": "node --import tsx/esm scripts/test-analyzer.ts",
    "ssg": "node --import tsx/esm scripts/run-ssg.ts",
    "publish": "node --import tsx/esm scripts/run-publisher.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.0-beta.45",
    "ai": "7.0.0-beta.81",
    "dotenv": "^16.4.0",
    "execa": "^9.5.0",
    "express": "^5.0.0",
    "fast-xml-parser": "^5.7.1",
    "fuse.js": "^7.0.0",
    "just-bash": "^2.14.2",
    "marked": "^18.0.2",
    "node-cron": "^4.2.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
