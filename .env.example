# Gemini API key — used by @ai-sdk/google in Phase 2
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional: override data directory (default: ./data)
# SPECULA_DATA_DIR=/absolute/path/to/data

# RSSHub secrets — only needed if your pipelines use those routes
# TWITTER_AUTH_TOKEN=
# TWITTER_CT0=
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
